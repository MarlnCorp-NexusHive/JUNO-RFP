# Company Intelligence (Proposal Manager) - optional
# Get a free key at https://site.financialmodelingprep.com/developer/docs
# Copy this file to .env and add your key, then restart: npm run dev
VITE_FMP_API_KEY=

# API base (production / preview builds). Leave unset in dev to use Vite proxy → juno-backend.
# Required on Netlify / static hosting: set in the host’s env to your public juno-backend URL (https, no trailing slash).
# VITE_API_URL=https://your-juno-backend.example.com
# VITE_API_URL=http://localhost:3000

# Where Vite should forward API routes in dev (default: juno-backend on 3000).
# VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:3000

# Team Collab: auto-login as PM when main JUNO user is Proposal Manager (defaults match juno-backend seed).
# VITE_COLLAB_PM_EMAIL=jordan@juno
# VITE_COLLAB_PM_PASSWORD=pm123

# Trial tenancy (logical multi-tenant on same Netlify + Render deploy).
# Provision users with: npm run create-trial -- --company "Acme" --email jane@acme.com
# Optional: set JUNO_APP_URL so the script prints the correct login link.
# JUNO_APP_URL=https://junorfp.com

# Resend (trial self-signup confirmation emails) — set these in juno-backend/.env (or root if you load it there)
# Get a free API key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=JUNO RFP <noreply@marlncorp.ai>
# JUNO_APP_URL=http://localhost:5173

# Trial user DB path (Render Persistent Disk — paid instance required for disks).
# 1) Upgrade JUNO-RFP web service off Free → Starter (or higher)
# 2) Service → Disk → Add disk, mount path: /var/data (1 GB is enough)
# 3) Environment → TRIAL_DATA_PATH=/var/data/trial-tenants.json
# Without this, trial signups are wiped when Render restarts/redeploys.
# TRIAL_DATA_PATH=/var/data/trial-tenants.json
# Or: TRIAL_DATA_DIR=/var/data
