# =============================================================================
# SECTION 13 — END-TO-END USER JOURNEYS
# =============================================================================

# --- Proposal Manager: full lifecycle ---

PROGRAM ProposalManagerJourney(user, rfpFile, opportunityInput)

  # Phase 1 — Capture & intel
  opportunity = CoreService.createOpportunity(user, opportunityInput)
  issuer      = CompanyIntelService.lookupIssuer(user, opportunityInput.issuerName)
  CompanyIntelService.attachIssuerToOpportunity(user, opportunity.id, issuer.id)
  opportunity = CoreService.qualifyOpportunity(user, opportunity.id, { summary: issuer.summary })

  IF opportunity.status != "active"
    RETURN { status: "not_qualified", opportunity }
  END IF

  # Phase 2 — Ingest & structure
  upload = DocumentService.uploadRfp(user, opportunity.id, rfpFile)
  WAIT UNTIL structure job completes FOR upload.document.id

  workspace = CoreService.getWorkspace(user, opportunity.id)

  # Phase 3 — Plan & assign
  writers  = DB.getUsersByRole(user.orgId, "writer")
  auditors = DB.getUsersByRole(user.orgId, "auditor")

  FOR EACH requirement IN workspace.requirements
    assignee = pickAssignee(requirement, writers, auditors)
    CollabService.assignRequirement(user, requirement.id, assignee.id, opportunity.dueDate)
  END FOR

  # Phase 4 — PM drafts priority items
  FOR EACH requirement IN topPriority(workspace.requirements, limit = 10)
    CoreService.generateAiDraft(user, requirement.id,
      { documentText: upload.document.extractedText })
  END FOR

  # Phase 5 — Monitor until compliance passes
  LOOP
    compliance = CoreService.runComplianceCheck(user, opportunity.id)
    IF compliance.missing.length == 0 AND compliance.risks.length == 0
      BREAK
    END IF
    WAIT 30s OR receive CollabService.streamActivity event
  END LOOP

  # Phase 6 — Pricing approval
  pricing = CoreService.savePricingModel(user, opportunity.id, defaultLineItems())
  CoreService.submitPricingForApproval(user, pricing.id)
  WAIT UNTIL pricing.status == "approved"

  # Phase 7 — Export & submit
  exportJob = DocumentService.requestExport(user, opportunity.id, "docx_styled")
  WAIT UNTIL exportJob.status == "completed"

  downloadUrl = DocumentService.downloadExport(user, exportJob.id)
  CoreService.markSubmitted(user, opportunity.id, { artifactUrl: downloadUrl })

  # Phase 8 — Archive
  CoreService.closeOpportunity(user, opportunity.id, "submitted", "Submitted on time")

  RETURN { status: "complete", downloadUrl, opportunityId: opportunity.id }
END PROGRAM


# --- RFP Auditor: assigned work ---

PROGRAM AuditorJourney(user)

  dashboard = CollabService.getAuditorDashboard(user.id)

  FOR EACH item IN dashboard.assignments
    draft = CoreService.generateAiDraft(user, item.requirementId, item.context)
    draft = applyUserEdits(draft)
    CoreService.saveAnswerDraft(user, item.requirementId, draft.contentHtml)
    CollabService.submitAnswer(user, draft.id)
  END FOR

  FOR EACH item IN dashboard.awaitingReview
    answer   = DB.getAnswer(item.answerId, user.orgId)
    analysis = AI.reviewForCompliance({
      requirement: item.requirementText,
      answer: answer.contentPlain,
      policy: DB.getCompliancePolicy(user.orgId)
    })

    IF analysis.pass
      CollabService.reviewAnswer(user, answer.id, "approved", analysis.summary)
    ELSE
      CollabService.reviewAnswer(user, answer.id, "changes_requested",
        join(analysis.issues, "\n"))
    END IF
  END FOR

  RETURN dashboard
END PROGRAM


# =============================================================================
# SECTION 14 — AI ORCHESTRATOR (SERVER-SIDE ONLY)
# =============================================================================

MODULE AiOrchestrator

  FUNCTION structureRequirements({ text, issuer })
    prompt = buildStructurePrompt(text, issuer)
    response = OPENAI.chat(prompt, model = "gpt-4.1", responseFormat = "json")
    RETURN parseRequirementsJson(response)
  END FUNCTION

  FUNCTION extractImportantDates(text)
    prompt = buildDateExtractionPrompt(text)
    response = OPENAI.chat(prompt, model = "gpt-4.1", responseFormat = "json")
    RETURN parseDatesJson(response)
  END FUNCTION

  FUNCTION generateAnswer({ question, rfpContext, companyProfile, reusableContent, tone })
    prompt = buildAnswerPrompt(question, rfpContext, companyProfile, reusableContent, tone)
    response = OPENAI.chat(prompt, model = "gpt-4.1")
    RETURN { html: toHtml(response), plain: response }
  END FUNCTION

  FUNCTION generateCompanySnapshot(query)
    prompt = buildCompanyIntelPrompt(query)
    response = OPENAI.chat(prompt, model = "gpt-4.1", responseFormat = "json")
    RETURN parseCompanyJson(response)
  END FUNCTION

  FUNCTION mergeStyledTemplate(workspace, templateId)
    template = S3.get("templates/" + templateId)
    mapping  = OPENAI.chat(buildStyledExportPrompt(workspace, template),
      model = "gpt-4o", responseFormat = "json")
    RETURN applyOoxmlMerge(template, mapping)
  END FUNCTION

  FUNCTION generateSlideDeck(contentSummary)
    outline = OPENAI.chat(buildSlideOutlinePrompt(contentSummary), model = "gpt-4.1")
    RETURN renderPptx(outline)
  END FUNCTION

  FUNCTION scoreCaptureFit({ issuer, rfpSummary, pastWins, capacity })
    prompt = buildCaptureScorePrompt(issuer, rfpSummary, pastWins, capacity)
    response = OPENAI.chat(prompt, model = "gpt-4.1", responseFormat = "json")
    RETURN parseCaptureScore(response)
  END FUNCTION

  FUNCTION reviewForCompliance({ requirement, answer, policy })
    prompt = buildComplianceReviewPrompt(requirement, answer, policy)
    response = OPENAI.chat(prompt, model = "gpt-4.1", responseFormat = "json")
    RETURN parseComplianceResult(response)
  END FUNCTION

END MODULE


